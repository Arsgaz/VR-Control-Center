{
  "name": "vr-control-center",
  "version": "0.3.1",
  "description": "Local desktop application for VR headset management.",
  "main": "./out/main/index.js",
  "scripts": {
    "format": "prettier --write .",
    "lint": "eslint .",
    "test": "vitest run",
    "typecheck": "npm run typecheck:main && npm run typecheck:renderer && npm run typecheck:tests",
    "typecheck:main": "tsc --noEmit -p tsconfig.node.json",
    "typecheck:renderer": "vue-tsc --noEmit -p tsconfig.web.json",
    "typecheck:tests": "tsc --noEmit -p tests/tsconfig.json",
    "electron:install": "install-electron",
    "dev": "node scripts/dev.mjs",
    "build": "npm run typecheck && electron-vite build",
    "build:mac": "npm run build && electron-builder --mac",
    "build:win": "npm run tools:prepare:win && npm run build && electron-builder --win --x64 --publish never && npm run verify:win && node scripts/write-release-checksums.mjs",
    "postinstall": "npm run electron:install && electron-builder install-app-deps",
    "tools:prepare:win": "node scripts/prepare-windows-tools.mjs",
    "verify:win": "node scripts/verify-windows-package.mjs",
    "branding:generate": "swift scripts/generate-branding.swift"
  },
  "dependencies": {
    "electron-log": "^5.4.3",
    "vue": "^3.5.22",
    "vue-i18n": "^11.4.6"
  },
  "devDependencies": {
    "@electron-toolkit/tsconfig": "^1.0.1",
    "@eslint/js": "^9.38.0",
    "@vitejs/plugin-vue": "^6.0.1",
    "electron": "^43.1.0",
    "electron-builder": "^26.0.12",
    "electron-vite": "^4.0.1",
    "eslint": "^9.38.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-vue": "^10.5.1",
    "prettier": "^3.6.2",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.46.2",
    "vite": "^7.1.11",
    "vitest": "^4.0.15",
    "vue-tsc": "^3.1.1"
  },
  "build": {
    "appId": "com.vrcontrolcenter.desktop",
    "productName": "VR Control Center",
    "directories": {
      "output": "dist"
    },
    "files": [
      "out/**/*",
      "package.json"
    ],
    "mac": {
      "target": [
        "dmg"
      ],
      "icon": "resources/branding/icon.icns"
    },
    "win": {
      "target": [
        "nsis",
        "zip"
      ],
      "icon": "resources/branding/icon.ico",
      "artifactName": "VR-Control-Center-${version}-win-${arch}.${ext}",
      "extraResources": [
        {
          "from": "resources/tools/win32-x64",
          "to": "tools/win32-x64",
          "filter": [
            "**/*"
          ]
        },
        {
          "from": "resources/third-party",
          "to": "third-party",
          "filter": [
            "**/*"
          ]
        },
        {
          "from": "resources/windows/README-RU.txt",
          "to": "README-Windows.txt"
        },
        {
          "from": "resources/steamvr",
          "to": "steamvr",
          "filter": [
            "**/*"
          ]
        }
      ]
    },
    "extraResources": [
      {
        "from": "resources/branding",
        "to": "branding",
        "filter": [
          "**/*"
        ]
      },
      {
        "from": "resources/third-party/GOLOS-TEXT-OFL.txt",
        "to": "font-licenses/GOLOS-TEXT-OFL.txt"
      }
    ],
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "artifactName": "VR-Control-Center-${version}-win-${arch}-setup.${ext}",
      "createDesktopShortcut": true
    }
  },
  "engines": {
    "node": ">=24.0.0"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/Arsgaz/VR-Control-Center.git"
  },
  "author": "OnePlace"
}
